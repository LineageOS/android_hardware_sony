hidl_package_root {
    name: "vendor.egistec",
    path: "hardware/sony/interfaces/egistec",
}

hidl_package_root {
    name: "vendor.semc",
    path: "hardware/sony/interfaces/semc",
}

aidl_interface {
    name: "vendor.semc.hardware.aidldisplay",
    system_ext_specific: true,
    vendor_available: true,
    local_include_dir: "aidl",
    srcs: ["aidl/vendor/semc/hardware/aidldisplay/*.aidl"],
    stability: "vintf",
    owner: "sony",

    backend: {
        cpp: {
            enabled: true,
        },
        java: {
            sdk_version: "module_current",
        },
    },
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
        {
            version: "2",
            imports: [],
        },
    ],
}

cc_library_shared {
    name: "vendor.semc.hardware.aidldisplay-V1-ndk_platform",
    shared_libs: ["libbinder_ndk"],
    system_ext_specific: true,
    vendor_available: true,
    whole_static_libs: ["vendor.semc.hardware.aidldisplay-V1-ndk"],
}
