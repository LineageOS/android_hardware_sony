android_app {
    name: "XperiaParts",
    defaults: ["SettingsLibDefaults"],

    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],

    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,

    static_libs: [
        "androidx.core_core",
        "androidx.preference_preference",
        "org.lineageos.platform.internal",
        "vendor.semc.hardware.display-V2.0-java",
        "vendor.semc.hardware.display-V2.1-java",
        "vendor.semc.hardware.display-V2.2-java"
    ],

    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },

    required: [
        "privapp-permissions_org.lineageos.settings.device",
        "config-org.lineageos.settings.device",
    ],
}

prebuilt_etc {
    name: "privapp-permissions_org.lineageos.settings.device",
    sub_dir: "permissions",
    src: "privapp-permissions_org.lineageos.settings.device.xml",
    system_ext_specific: true,
    filename_from_src: true,
}

prebuilt_etc {
    name: "config-org.lineageos.settings.device",
    sub_dir: "sysconfig",
    src: "config-org.lineageos.settings.device.xml",
    system_ext_specific: true,
    filename_from_src: true,
}
