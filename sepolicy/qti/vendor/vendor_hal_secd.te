binder_call(vendor_hal_secd_client, vendor_hal_secd_server)
binder_call(vendor_hal_secd_server, vendor_hal_secd_client)

add_hwservice(vendor_hal_secd_server, vendor_hal_secd_hwservice)
add_service(vendor_hal_secd_server, hal_secd_service)

allow vendor_hal_secd_client vendor_hal_secd_hwservice:hwservice_manager find;
allow vendor_hal_secd_client hal_secd_service:service_manager find;
